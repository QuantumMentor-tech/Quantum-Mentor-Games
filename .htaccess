# ============================================================
# QMGames Store - Apache Configuration (.htaccess)
# Requires: Apache with mod_rewrite enabled (XAMPP default)
# ============================================================

# ---------- Enable Rewrite Engine ----------
Options -Indexes
Options +FollowSymLinks
RewriteEngine On

# ---------- Custom 404 Page ----------
ErrorDocument 404 /quantum-mentor-games-store/404.php

# ---------- Force HTTPS (uncomment on live server) ----------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------- Remove www (optional — uncomment if needed) ----------
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------- Protect Sensitive Files ----------

# Block direct access to includes
<FilesMatch "^(config|db|functions|auth|admin-header|admin-sidebar|admin-footer|header|navbar|footer)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block direct access to logs
<FilesMatch "\.(log|sql)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block .htaccess itself from being read
<Files ".htaccess">
  Order allow,deny
  Deny from all
</Files>

# Deny direct access to sensitive directories
<IfModule mod_rewrite.c>
  RewriteRule ^(includes|database|logs)(/|$) - [F,L]
</IfModule>

# ---------- Prevent PHP execution in uploads ----------
<IfModule mod_rewrite.c>
  RewriteRule ^assets/uploads/.*\.(php|php5|phtml|pl|cgi|sh)$ - [F,L]
</IfModule>

# ---------- Security Headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Content-Security-Policy (tighten before production)
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline';"
</IfModule>

# ---------- Compression (performance) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript text/plain
</IfModule>

# ---------- Browser Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg           "access plus 3 months"
  ExpiresByType image/png            "access plus 3 months"
  ExpiresByType image/webp           "access plus 3 months"
  ExpiresByType image/gif            "access plus 3 months"
</IfModule>

# ---------- PHP Settings (XAMPP) ----------
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
  php_value max_execution_time 60
</IfModule>
